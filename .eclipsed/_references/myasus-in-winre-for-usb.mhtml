@charset "utf-8";

.live-chat { display: flex; position: fixed; background-color: rgb(0, 148, =
242); box-sizing: border-box; padding: 5px 20px 5px 10px; width: auto; bott=
om: 9px; right: 20px; height: auto; border-radius: 100px; border: 0px; box-=
shadow: none; }

.live-chat a { text-decoration: none; }

.live-chat .icon { margin-right: 10px; width: 30px; height: 30px; backgroun=
d-image: url("../images/imageDist/icon-icr.png"); background-size: cover; b=
ackground-position: center center; }

.live-chat::after { content: ""; position: absolute; background-color: rgb(=
0, 148, 242); bottom: -4px; right: 25px; width: 8px; height: 8px; transform=
: rotate(45deg); }

.live-chat a { text-shadow: none; background: none; display: flex; align-it=
ems: center; width: 100%; height: 100%; }

.live-chat a::before { display: none; }

.live-chat a p { position: relative; font-size: 12px; top: 0px; bottom: 0px=
; color: rgb(255, 255, 255); margin: 0px; padding: 0px; }

@media only screen and (max-width: 900px) {
  .live-chat { width: 100%; padding: 14px 20px; border-radius: 0px; right: =
0px; bottom: 0px; z-index: 10000; box-shadow: rgba(0, 0, 0, 0.51) 2px 0px 6=
px; }
  .live-chat a { display: flex; justify-content: center; align-items: cente=
r; position: relative; width: 100%; height: 100%; text-align: center; }
  .live-chat a p { font-size: 16px; color: rgb(255, 255, 255); }
}
