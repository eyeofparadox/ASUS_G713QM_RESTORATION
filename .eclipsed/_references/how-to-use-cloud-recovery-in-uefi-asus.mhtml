.pd-select .pd-line li > a .pd-select .pd-line li .pd-title { transition: 0=
.2s cubic-bezier(0.23, 1, 0.32, 1); }

.pd-select > ul { transition: 1.2s cubic-bezier(0.23, 1, 0.32, 1); }

.page-callus { font-size: 20px; }

.page-callus #h_title { font-size: 1.6em; padding: 0.5em 0px 0.2em; }

.page-callus .desp { font-size: 0.8em; color: rgb(102, 102, 102); line-heig=
ht: 20px; }

.pd-select { position: relative; max-width: 100%; overflow: hidden; padding=
: 17% 0px 2em; border-bottom: 1px solid rgb(224, 224, 224); }

.pd-select * { box-sizing: border-box; }

.pd-select > ul { position: absolute; top: 0px; width: 100%; display: block=
; transform: translateY(0%); padding: 1.9em 0px 2em; }

.pd-select > ul > li { display: inline-block; float: left; width: 100%; opa=
city: 1; }

.pd-select > ul > li + li { opacity: 0; visibility: hidden; }

.pd-select > ul.move { transform: translateY(-8em); }

.pd-select > ul.move > li { opacity: 0; visibility: hidden; }

.pd-select > ul.move > li + li { opacity: 1; visibility: visible; }

.pd-select .pd-line > ul { margin: 0px -0.85em; }

.pd-select .pd-line li { display: inline-block; position: relative; width: =
14.285%; float: left; padding: 0px 0.85em; }

.pd-select .pd-line li > a { display: inline-block; position: relative; wid=
th: 100%; padding-top: 112.5%; border: 1px solid rgb(224, 224, 224); border=
-radius: 0.6em; }

.pd-select .pd-line li:hover > a, .pd-select .pd-line li.active > a { borde=
r: 1px solid rgb(0, 148, 242); }

.pd-select .pd-line li .pd-title { display: block; width: 100%; position: a=
bsolute; padding: 0px 1em; line-height: 1.4em; text-align: center; top: 60%=
; font-size: 0.65em; color: rgb(68, 68, 68); word-break: break-word; }

.pd-select .pd-line li.active > a .pd-title, .pd-select .pd-line li:hover >=
 a .pd-title { color: rgb(0, 148, 242); }

.pd-select .pd-other .btn-back { font-size: 0.9em; text-transform: uppercas=
e; }

.pd-select .pd-other .btn-back .icon-sp-back { display: inline-block; }

.pd-select .pd-other .btn-back .icon-sp-back svg { width: 0.35em; margin-ri=
