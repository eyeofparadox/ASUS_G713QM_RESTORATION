param (
    [string]$SourceRoot
    [string]$TargetRoot
    [switch]$SimulateOnly
    [string]$LogTail
    [switch]$EnableHashFallback
) # &lt;=3D=3D=3D we're really here! LOOK!!! &lt;grumbling at parser&gt;

if (-not $SourceRoot)     { $SourceRoot     =3D "G:\Lab\_In" }
if (-not $TargetRoot)     { $TargetRoot     =3D "G:\Lab\_Open" }
if (-not $LogTail)        { $LogTail        =3D "delta-run" }

$logBuffer =3D @()
$sampleIndex =3D 0
$hashCache =3D @{}

function Get-RelativePath {
    param ($file, $root)
    return $file.FullName.Substring($root.Length).TrimStart('\')
}

function Get-FileHashID {
    param ($file)
    if ($hashCache.ContainsKey($file.FullName)) {
        return $hashCache[$file.FullName]
    }
    try {
        $hash =3D Get-FileHash -Path $file.FullName -Algorithm SHA256
        $hashCache[$file.FullName] =3D $hash.Hash
        return $hash.Hash
    } catch {
        return "HASH_ERROR"
    }
}

Write-Host "`n[CanonMerge v0.8-dev =E2=80=94 Clean Delta Run]"

# Step 1: Index source and target
$sourceFiles =3D Get-ChildItem -Path $SourceRoot -Recurse -File
$targetFiles =3D Get-ChildItem -Path $TargetRoot -Recurse -File

$sourceMap =3D @{}
$targetMap =3D @{}

foreach ($sf in $sourceFiles) {
    $rel =3D Get-RelativePath $sf $SourceRoot
    $sourceMap[$rel] =3D $sf
}
foreach ($tf in $targetFiles) {
    $rel =3D Get-RelativePath $tf $TargetRoot
    $targetMap[$rel] =3D $tf
}

# Step 2: Analyze differences
foreach ($rel in $sourceMap.Keys) {
    $sampleIndex++
    $src =3D $sourceMap[$rel]
    $status =3D ""
    $reason =3D ""
    $confidence =3D ""

    $srcPath =3D $src.FullName
    $srcSize =3D [math]::Round($src.Length / 1KB, 2)
    $srcTime =3D $src.LastWriteTime

    if ($targetMap.ContainsKey($rel)) {
        $tgt =3D $targetMap[$rel]
        if ($src.Length -eq $tgt.Length -and $src.LastWriteTime -eq $tgt.La=
stWriteTime) {
            $status =3D "[Identical]"
            $reason =3D "Size and timestamp match"
        } elseif ($src.Length -ne $tgt.Length -or $src.LastWriteTime -gt $t=
gt.LastWriteTime) {
            $status =3D "[Updated]"
            $reason =3D "Size or timestamp differs"
        }
    } else {
        $matchFound =3D $false
        if ($EnableHashFallback) {
            $srcHash =3D Get-FileHashID -file $src
            foreach ($tfile in $targetFiles) {
                if ($tfile.Length -eq $src.Length) {
                    $tHash =3D Get-FileHashID -file $tfile
                    if ($tHash -eq $srcHash) {
                        $status =3D "[Candidate:MovedOrRenamed]"
                        $reason =3D "Hash match but different path"
                        $confidence =3D "High"
                        $matchFound =3D $true
                        break
                    }
                }
            }
        }
        if (-not $matchFound) {
            $status =3D "[New]"
            $reason =3D "No match found in target"
        }
    }

