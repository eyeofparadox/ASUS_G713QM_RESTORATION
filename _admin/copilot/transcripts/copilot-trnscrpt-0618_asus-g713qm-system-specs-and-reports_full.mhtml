.PARAMETER SourceRoot
    Primary repository root (e.g., G:\Lab\_In)

.PARAMETER TargetRoot
    Comparison repository root (e.g., G:\Lab\_Open)

.PARAMETER SimulateOnly
    If set, performs a dry run without any changes

.PARAMETER LogTail
    Custom suffix for the log file name

.PARAMETER EnableHashFallback
    Optional deep-matching for moved/renamed outliers

.PARAMETER EnableOverflow
    Enables overflow redirection (future use)

#&gt;

param (
    [string]$SourceRoot =3D "G:\Lab\_In",
    [string]$TargetRoot =3D "G:\Lab\_Open",
    [switch]$SimulateOnly,
    [string]$LogTail =3D "delta-run-001",
    [switch]$EnableHashFallback,
    [switch]$EnableOverflow
)

$logBuffer =3D @()
$sampleIndex =3D 0
$hashCache =3D @{}

function Get-RelativePath ($file, $root) {
    return $file.FullName.Substring($root.Length).TrimStart('\')
}

function Get-FileHashID ($file) {
    if ($hashCache.ContainsKey($file.FullName)) {
        return $hashCache[$file.FullName]
    }
    try {
        $hash =3D Get-FileHash -Path $file.FullName -Algorithm SHA256
        $hashCache[$file.FullName] =3D $hash.Hash
        return $hash.Hash
    } catch {
        return "HASH_ERROR"
    }
}

Write-Host "`n[CanonMerge v0.8-dev =E2=80=94 Delta Pass]"

# Step 1: Index source and target
$sourceFiles =3D Get-ChildItem -Path $SourceRoot -Recurse -File
$targetFiles =3D Get-ChildItem -Path $TargetRoot -Recurse -File

$sourceMap =3D @{}
$targetMap =3D @{}

foreach ($sf in $sourceFiles) {
    $rel =3D Get-RelativePath $sf $SourceRoot
    $sourceMap[$rel] =3D $sf
}
foreach ($tf in $targetFiles) {
    $rel =3D Get-RelativePath $tf $TargetRoot
    $targetMap[$rel] =3D $tf
}

# Step 2: Analyze differences
foreach ($rel in $sourceMap.Keys) {
    $sampleIndex++
    $src =3D $sourceMap[$rel]
    $status =3D ""
    $reason =3D ""
    $confidence =3D ""
    $hashMatch =3D ""

    if ($targetMap.ContainsKey($rel)) {
        $tgt =3D $targetMap[$rel]
        if ($src.Length -eq $tgt.Length -and $src.LastWriteTime -eq $tgt.La=
stWriteTime) {
            $status =3D "[Identical]"
            $reason =3D "Size and timestamp match"
        } elseif ($src.Length -ne $tgt.Length -or $src.LastWriteTime -gt $t=
gt.LastWriteTime) {
            $status =3D "[Updated]"
            $reason =3D "Source newer or larger than target"
        }
    } else {
        # Target missing =E2=80=94 try to resolve as moved or renamed
        $matchFound =3D $false

        if ($EnableHashFallback) {
            $srcHash =3D Get-FileHashID $src
            foreach ($tfile in $targetFiles) {
                if ($tfile.Length -eq $src.Length) {
                    $tHash =3D Get-FileHashID $tfile
                    if ($tHash -eq $srcHash) {
                        $status =3D "[Candidate:MovedOrRenamed]"
                        $reason =3D "Size + hash match, different path"
                        $confidence =3D "High"
                        $matchFound =3D $true
                        break
                    }
                }
            }
        }

        if (-not $matchFound) {
            $status =3D "[New]"
            $reason =3D "No path or fingerprint match in target"
        }
    }

$logBuffer +=3D @"
## Sample #$sampleIndex
Status: $status
Source Path: $($src.FullName)
Size: $([math]::Round($src.Length / 1KB, 2)) KB
Modified: $($src.LastWriteTime)

Reason: $reason
Confidence: $confidence

"@
}

# Step 3: Write log
$logFile =3D "delta-log-$LogTail.md"
$logBuffer | Out-File $logFile -Encoding UTF8 -Force
Write-Host "`n[Delta log written to: $logFile]"

