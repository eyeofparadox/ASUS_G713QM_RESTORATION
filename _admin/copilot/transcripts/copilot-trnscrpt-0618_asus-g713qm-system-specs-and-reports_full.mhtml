-v0.7.ps1
&lt;#
.SYNOPSIS
    Canon-aware dry-run merge tool with semantic diffing, overflow redirect=
ion, and structured logging.

.PARAMETER SourceRoot
    Primary comparison folder (e.g., Git-G)

.PARAMETER TargetRoot
    Secondary comparison folder (e.g., Git-X)

.PARAMETER SampleParents
    Number of top-level folders to include (/p)

.PARAMETER SampleDepth
    Subdirectory depth to scan within each parent (/d)

.PARAMETER SampleLimit
    Max number of files to simulate (/s)

.PARAMETER SimulateOnly
    [Switch] If set, outputs where files would go without comparing content

.PARAMETER LogTail
    Naming tail for .md logs (e.g., dryrun-sample-001)

.PARAMETER EnableOverflow
    [Switch] Redirect &gt;2GB files to overflow staging path

.PARAMETER OverflowRoot
    Custom overflow target, defaults to ..\Lab\Overflow
#&gt;

param (
    [string]$SourceRoot =3D "G:\Lab\_In",
    [string]$TargetRoot =3D "G:\Lab\_Open",
    [int]$SampleParents =3D 3,
    [int]$SampleDepth =3D 5,
    [int]$SampleLimit =3D 15,
    [switch]$SimulateOnly,
    [switch]$EnableOverflow,
    [string]$OverflowRoot =3D "..\Lab\Overflow",
    [string]$LogTail =3D "dryrun-001",
    [switch]$LogCompact
)

# function Parse-CanonName($filePath) {
    # $base =3D [System.IO.Path]::GetFileNameWithoutExtension($filePath)
    # $ext =3D [System.IO.Path]::GetExtension($filePath)
    # return "$($base)-canonicalized$ext"
# }

# Identify top-level folders to sample
$parents =3D Get-ChildItem -Path $SourceRoot -Directory | Select-Object -Fi=
rst $SampleParents
$files =3D foreach ($parent in $parents) {
    Get-ChildItem -Path $parent.FullName -Recurse -Depth $SampleDepth -File=
 |
        Select-Object -First ($SampleLimit / $SampleParents)
}

# Initialize output buffer
$logSample =3D @()
$counter =3D 0
$overflowThreshold =3D 2GB
$charLimit =3D if ($LogCompact) { 7800 } else { [int]::MaxValue }
$currentLength =3D 0

# Header block
$logHeader =3D @"
## CanonMerge v0.7b =E2=80=93 Sample Report =20
LogMode: $(if ($LogCompact) { "Compact" } else { "Full" }) =20
SampleParents: $SampleParents =20
SampleDepth: $SampleDepth =20
SampleLimit: $SampleLimit =20
OverflowThreshold: 2GB =20
EnableOverflow: $($EnableOverflow.IsPresent) =20

---
"@
$logSample +=3D $logHeader
$currentLength +=3D $logHeader.Length

# Begin per-sample logging
foreach ($file in $files) {
    $counter++
    $relativePath =3D $file.FullName.Substring($SourceRoot.Length).TrimStar=
t('\')
    # $canonName =3D Parse-CanonName $file.FullName
    $destPath =3D Join-Path $TargetRoot $relativePath
    $isOverflow =3D $EnableOverflow -and ($file.Length -gt $overflowThresho=
ld)
    $newPath =3D if ($isOverflow) { Join-Path $OverflowRoot $relativePath }=
 else { $destPath }
    $status =3D if ($isOverflow) { "WOULD REDIRECT TO OVERFLOW" } else { "W=
OULD COPY TO TARGET" }

    $entry =3D @"
## Sample #$counter =20
Source: $($file.FullName) =20
Size: $([math]::Round($file.Length / 1MB, 2)) MB =20
# Canonical Name: $canonName =20
Target: $newPath =20
Status: $status =20

"@
    $currentLength +=3D $entry.Length
    if ($currentLength -gt $charLimit) { break }
    $logSample +=3D $entry
}

# Write to log file
$logFile =3D "merge-$LogTail.md"
$logSample | Out-File $logFile -Encoding UTF8 -Force

Write-Host "`n[CanonMerge Sample Pass Complete]"
Write-Host "=3D=3D&gt; Sample log written to: $logFile"

&lt;#
-scriptLaunchAt	G:\Lab\_In\GitHub\_admin\scripts

.\CanonMerge-v0.7b.ps1
